# FeedLink AI Backend Environment Variables

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/feedlink_ai

# Server port
PORT=3000

# JWT authentication secret (change in production!)
JWT_SECRET=dev-secret-change-in-production

# JWT token expiry duration
JWT_EXPIRES_IN=7d

# Google Gemini API key (optional — enables AI food analysis & smart matching)
# Get your key at: https://makersuite.google.com/app/apikey
# If left empty, the platform falls back to deterministic analysis
GEMINI_API_KEY=

# Admin account bootstrap (created once on first server start)
# Set both values; ADMIN_PASSWORD must be at least 12 characters.
# The existing admin is never overwritten on later starts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
